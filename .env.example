# Public build configuration. Only public ingestion tokens belong here.
# Default off. test is a local-only fake. production accepts https://danimon.party only.
PUBLIC_ANALYTICS_MODE=off
PUBLIC_POSTHOG_KEY=
PUBLIC_CLOUDFLARE_TOKEN=
# Set only after verifying automatic injection is OFF in the actual zone/site.
PUBLIC_CLOUDFLARE_MANUAL_AUDITED=false
