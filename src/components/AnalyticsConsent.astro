---
const { lang = 'en' } = Astro.props as { lang?: 'en' | 'es' };
const es = lang === 'es';
---
<div class="privacy-access">
  <button type="button" data-privacy-open hidden>{es ? 'Privacidad' : 'Privacy'}</button>
  <noscript><a href={es ? '/es/privacidad/' : '/privacy/'}>{es ? 'Privacidad' : 'Privacy'}</a></noscript>
</div>
<section class="consent-card" data-consent-banner role="region" aria-labelledby="consent-title" hidden>
  <h2 id="consent-title">{es ? 'Tú eliges qué compartes' : 'You choose what you share'}</h2>
  <p>{es ? 'Con tu permiso, medimos visitas e interacciones para mejorar este portfolio. Puedes rechazarlo y cambiar tu decisión cuando quieras.' : 'With your permission, we measure visits and interactions to improve this portfolio. You can decline and change your choice at any time.'}</p>
  <div class="consent-actions">
    <button type="button" data-consent-reject>{es ? 'Rechazar analítica' : 'Reject analytics'}</button>
    <button type="button" data-consent-accept>{es ? 'Aceptar analítica' : 'Accept analytics'}</button>
    <button type="button" data-privacy-open>{es ? 'Configurar' : 'Preferences'}</button>
  </div>
  <a href={es ? '/es/cookies/' : '/cookies/'}>{es ? 'Cómo usamos los datos' : 'How we use data'}</a>
</section>
<dialog class="privacy-dialog" data-privacy-dialog aria-labelledby="privacy-title">
  <form method="dialog" class="privacy-close"><button aria-label={es ? 'Cerrar preferencias' : 'Close preferences'}>×</button></form>
  <h2 id="privacy-title">{es ? 'Tus preferencias' : 'Your preferences'}</h2>
  <p>{es ? 'La web funciona con todas las opciones desactivadas. Tu decisión se guarda durante seis meses.' : 'The website works with all options disabled. Your choice is stored for six months.'}</p>
  <form data-privacy-form>
    <label class="preference"><span><strong>{es ? 'Estadísticas de visitas' : 'Visit statistics'}</strong><small>{es ? 'Cloudflare Web Analytics. Páginas, procedencia aproximada y rendimiento.' : 'Cloudflare Web Analytics. Pages, approximate traffic origins and performance.'}</small></span><input type="checkbox" name="web" /></label>
    <label class="preference"><span><strong>{es ? 'Interacciones y recorridos' : 'Interactions and journeys'}</strong><small>{es ? 'PostHog EU. Proyectos, clics e hitos, sin contenido de formularios.' : 'PostHog EU. Projects, clicks and milestones, without form content.'}</small></span><input type="checkbox" name="interactions" /></label>
    <p class="replay-note">{es ? 'Las grabaciones de sesiones están desactivadas en este sitio.' : 'Session recordings are disabled on this website.'}</p>
    <p data-privacy-signal hidden>{es ? 'Respetamos la señal de privacidad de tu navegador. La analítica opcional permanece desactivada.' : 'We respect your browser privacy signal. Optional analytics stays disabled.'}</p>
    <div class="consent-actions">
      <button type="button" data-consent-reject>{es ? 'Rechazar analítica' : 'Reject analytics'}</button>
      <button type="button" data-consent-accept>{es ? 'Aceptar analítica' : 'Accept analytics'}</button>
      <button type="submit">{es ? 'Guardar preferencias' : 'Save preferences'}</button>
      <button type="button" data-consent-withdraw>{es ? 'Retirar consentimiento' : 'Withdraw consent'}</button>
    </div>
  </form>
  <p class="privacy-links"><a href={es ? '/es/privacidad/' : '/privacy/'}>{es ? 'Privacidad' : 'Privacy'}</a> · <a href={es ? '/es/cookies/' : '/cookies/'}>Cookies</a></p>
</dialog>
<span class="consent-status" data-privacy-status role="status" aria-live="polite"></span>
<script>
  import { initializeAnalytics, currentPreferences, savePreferences, withdrawConsent } from '../lib/analytics';
  import { startInstrumentation } from '../lib/analytics/instrument';
  initializeAnalytics();
  startInstrumentation();
  const banner = document.querySelector<HTMLElement>('[data-consent-banner]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-privacy-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-privacy-form]')!;
  const web = form.elements.namedItem('web') as HTMLInputElement;
  const interactions = form.elements.namedItem('interactions') as HTMLInputElement;
  const status = document.querySelector<HTMLElement>('[data-privacy-status]')!;
  const es = document.documentElement.lang === 'es';
  function refresh() {
    const { consent, signal, enabled } = currentPreferences();
    banner.hidden = !!consent || signal || !enabled;
    web.checked = !!consent?.web && !signal;
    interactions.checked = !!consent?.interactions && !signal;
    web.disabled = interactions.disabled = signal;
    dialog.querySelector<HTMLElement>('[data-privacy-signal]')!.hidden = !signal;
  }
  function saved() {
    dialog.close();
    refresh();
    status.textContent = es ? 'Preferencias de privacidad guardadas.' : 'Privacy preferences saved.';
  }
  document.querySelectorAll<HTMLButtonElement>('[data-privacy-open]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', () => { refresh(); if (!dialog.open) dialog.showModal(); });
  });
  document.querySelectorAll('[data-consent-accept]').forEach(button => button.addEventListener('click', () => { savePreferences(true, true); saved(); }));
  document.querySelectorAll('[data-consent-reject]').forEach(button => button.addEventListener('click', () => { savePreferences(false, false); saved(); }));
  document.querySelector('[data-consent-withdraw]')!.addEventListener('click', () => { withdrawConsent(); saved(); });
  form.addEventListener('submit', event => { event.preventDefault(); savePreferences(web.checked, interactions.checked); saved(); });
  window.addEventListener('portfolio:privacy-state', refresh);
  refresh();
</script>
<style>
  .privacy-access { position: fixed; bottom: .65rem; left: max(.7rem, env(safe-area-inset-left)); z-index: 21; }
  .privacy-access button, .privacy-access a { font: 500 .75rem "Space Grotesk",sans-serif; color: #e1f7ee; border: 1px solid #6b9c91; background: #0d2428; padding: .45rem .65rem; border-radius: 2rem; cursor: pointer; }
  .consent-card { position: fixed; left: max(1rem, env(safe-area-inset-left)); bottom: 3rem; z-index: 24; box-sizing: border-box; width: min(30rem, calc(100vw - 2rem)); max-height: calc(100dvh - 5rem); overflow: auto; background: #0e282d; color: #e8fff8; border: 1px solid #568278; border-radius: 1rem; padding: 1.15rem; box-shadow: 0 8px 32px #0008; }
  h2 { font: 400 2rem/1.1 "Instrument Serif", Georgia, serif; margin: 0 0 .75rem; }
  p { font-size: .92rem; line-height: 1.5; }
  a { color: #c9f7e5; text-underline-offset: .2em; }
  .consent-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1rem 0; }
  .consent-actions button { flex: 1 1 10rem; min-height: 44px; padding: .6rem .75rem; font: 550 .88rem "Space Grotesk",sans-serif; color: #edfff8; background: #173a3c; border: 1px solid #7ea99c; border-radius: .5rem; cursor: pointer; }
  .consent-actions button:hover { background: #28514e; }
  .privacy-dialog { box-sizing: border-box; width: min(35rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); padding: 1.5rem; overflow-y: auto; color: #e8fff8; background: #0e282d; border: 1px solid #649a8a; border-radius: 1rem; }
  .privacy-dialog::backdrop { background: #001416aa; }
  .privacy-close { display: flex; justify-content: flex-end; }
  .privacy-close button { width: 44px; height: 44px; border: 1px solid #7ea99c; border-radius: 50%; background: transparent; color: #e8fff8; font-size: 1.5rem; cursor: pointer; }
  .preference { display: flex; gap: 1rem; align-items: center; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid #50716a; }
  .preference small { display: block; color: #c6e3da; margin-top: .4rem; line-height: 1.5; }
  .preference input { flex: none; width: 1.4rem; height: 1.4rem; accent-color: #b0e7c6; }
  .replay-note { color: #c6e3da; }
  .consent-status { position: fixed; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 500px) { .consent-card { bottom: 3.2rem; } .privacy-dialog { padding: 1rem; } }
</style>
