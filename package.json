{
  "name": "danimon-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "build:pages": "astro check && node tools/build-pages.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "test:analytics": "node tools/run-analytics-tests.mjs",
    "test:counters": "wrangler deploy --dry-run --config wrangler.bundle.jsonc --outdir output/worker-test-build && node --test tools/counter-worker.test.mjs",
    "test:native": "node tools/check-native-analytics.mjs",
    "test:counters:e2e": "node tools/check-counter-e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.4.5",
    "tesseract.js": "7.0.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "lighthouse": "13.5.0",
    "miniflare": "^5.20261104.0-beta",
    "typescript": "6.0.3",
    "wrangler": "^4.158.0"
  }
}
